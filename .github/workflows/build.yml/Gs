name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip -q RattewOptionApiQZ.zip
      
      # ตั้งค่า Java เป็นเวอร์ชัน 5
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '5'

      # เพิ่มการตั้งค่า Node.js เวอร์ชัน 24
      - uses: actions/setup-node@v4
        with:
          node-version: '24'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7
      - run: gradle assembleDebug
        working-directory: RattewOptionApiQZ
      - uses: actions/upload-artifact@v4
        with:
          name: RattewOptionApiQZ-apk
          path: RattewOptionApiQZ/app/build/outputs/apk/debug/*.apk
